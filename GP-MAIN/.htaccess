Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve .html files for extension-less requests (mirrors Vercel cleanUrls: true)
  # Only fires when:
  #  1. The requested path is not an actual file
  #  2. The requested path is not an actual directory
  #  3. A matching .html file exists on disk
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]
</IfModule>
