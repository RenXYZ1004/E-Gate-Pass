# Gmail API / OAuth (set these only in Vercel Environment Variables or a local ignored .env file)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=your-business-email@example.com
GMAIL_FROM_NAME=Southville Gatepass System
APP_BASE_URL=https://your-project.vercel.app
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/oauth-callback

# Required for Vercel Blob photo uploads
BLOB_READ_WRITE_TOKEN=

# Optional request-origin restrictions
ALLOWED_ORIGINS=https://your-project.vercel.app
STRICT_ORIGIN=false

# Destination inbox for general website contact messages (required to activate contact form)
CONTACT_TO_EMAIL=

# Public SEO values used by the build. Set SITE_URL to the production origin if Vercel system variables are not exposed.
SITE_URL=
# Optional: configure only after the school approves Analytics and obtains consent policy approval.
GA_MEASUREMENT_ID=
# Optional Search Console HTML-tag verification token (not the domain DNS TXT value).
GOOGLE_SITE_VERIFICATION=
