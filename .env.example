# Gmail API / OAuth (set these only in Vercel Environment Variables or a local ignored .env file)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=your-business-email@example.com
GMAIL_FROM_NAME=Southville Gatepass System
APP_BASE_URL=https://your-project.vercel.app
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/oauth-callback

# Required for Vercel Blob photo uploads
BLOB_READ_WRITE_TOKEN=

# Optional request-origin restrictions
ALLOWED_ORIGINS=https://your-project.vercel.app
STRICT_ORIGIN=false
